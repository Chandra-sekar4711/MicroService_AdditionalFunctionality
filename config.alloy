// ============================================================
// LOG COLLECTION
// ============================================================

local.file_match "app_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/orders/customer-service.log",
      "service_name" = "CustomerService",
    },
    {
      "__path__" = "/var/log/orders/order-service.log",
      "service_name" = "OrderService",
    },
    {
      "__path__" = "/var/log/orders/payment-service.log",
      "service_name" = "PaymentService",
    },
    {
      "__path__" = "/var/log/orders/notification-service.log",
      "service_name" = "NotificationService",
    },
  ]
}

// ============================================================
// EXTRACT TRACE ID FROM LOGS
// ============================================================

loki.process "extract_trace" {
  forward_to = [loki.write.default.receiver]

  // Parse JSON log format
  stage.json {
    expressions = {
      trace_id = "traceId",
      span_id  = "spanId",
      level    = "level",
      service  = "service",
      message  = "message",
    }
  }

  // Extract trace_id as a label for querying
  stage.labels {
    values = {
      trace_id = "trace_id",
      level    = "level",
      service_name = "service",
    }
  }
}

loki.source.file "app_logs" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.extract_trace.receiver]   // ← Pipe into processor
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ============================================================
// TRACE COLLECTION
// ============================================================

otelcol.receiver.otlp "traces" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  timeout         = "5s"
  send_batch_size = 1024

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
      insecure_skip_verify = true
    }
  }
}